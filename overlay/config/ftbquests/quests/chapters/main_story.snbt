	quests: [
		{
			dependencies: [
				"49C9DC2F3D131A14"
				"5B31D4D4029F1891"
			]
			dependency_requirement: "one_completed"
			description: [
				"&eРекомендуемый уровень: 15"
				""
				"&7&oПерчатка, некогда бдительный страж и первый вестник Ада, ныне пала в тёмные объятия Пустоты. Порабощённая как один из вестников Пустоты, теперь она грозит гибелью собственному царству."
				""
				"&7&oПерчатку можно отыскать запертой в монолитной темнице. Разбейте её око — и высвободите обращённое порчей создание."
				""
				"&eСовет: &7Этот босс бьёт сильно и способен убить вас с одного удара на Обычной или Высокой сложности! Уклоняйтесь или сварите защитные зелья!"
				""
				"&8Английский"
				"{@pagebreak}"
				"&eРекомендуемый уровень: 15"
				""
				"&7&oEl Guantelete, una vez el vigilante y primer heraldo del Nether, ahora ha caído por el oscuro abrazo del Vacío. Esclavizado como uno de sus heraldos, amenaza con la destrucción de su propio reino, el Nether."
				""
				"&7&oPuedes encontrar el Guantelete encerrado dentro de una prisión monolítica. Rompe su ojo y desatarás a la bestia ahora corrompida."
				""
				"&eTip: &7Este jefe tiene ataques fuertes que pueden matarte de un golpe si juegas en dificultad Normal o Difícil! Intenta evadir los ataques o haz pociones defensivas."
				""
				"&8Испанский"
			]
			id: "1B76F8D3B54F3FE6"
			min_required_dependencies: 1
