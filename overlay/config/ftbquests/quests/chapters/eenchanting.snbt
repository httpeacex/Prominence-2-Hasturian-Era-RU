	quests: [
		{
			description: [
				"&7 Чтобы начать путь в чарах, освойте азы — раздобудьте зачаровательный стол."
				""
				"&7 При использовании зачаровательного стола вы увидите внизу три полосы: Этерна, Кванта и Аркана."
				""
				"&7 &aЭтерна&7 — определяет уровень зачаровательного стола. Она задаёт стоимость, а также то, какие чары вам доступны. Требуемый уровень опыта вдвое больше Этерны, так что 50 Этерны — это 100 уровней для зачарования."
				""
				"&7 &4Кванта&7 — чистый хаос. Чем её больше, тем случайнее становится всё вокруг. Выкручивать на максимум не рекомендуется."
				""
				"&7 &5Аркана&7 — эта характеристика влияет на редкость и количество чар. Максимум вам не нужен, если хотите получить что-то вроде Защиты или Солнечного пламени."
			]
			id: "2F8B1BF5905F954D"
			rewards: [{
				id: "55EED9C1AD97DB82"
				type: "xp_levels"
				xp_levels: 10
			}]
			shape: "pentagon"
			subtitle: "Дальнейшее улучшение снаряжения"
