		}
		{
			dependencies: ["6AD67E7C8CD78371"]
			description: ["&eМожно выковать из Эссенции Славы и Звёздной кузни вместе с Расплавленным Ядром."]
			id: "1CE7763C1889255C"
			shape: "hexagon"
			subtitle: "Выкованная из осколков умирающей звезды, Супернова — астральное оружие, наносящее урон всеми магическими стихиями и стирающее любые цели астральными взрывами."
			tasks: [{
				id: "6B6E9C04C7D69E89"
