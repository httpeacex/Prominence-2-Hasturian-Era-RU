			x: -3.0d
			y: 0.0d
		}
		{
			dependencies: ["6AD67E7C8CD78371"]
			description: ["&eМожно выковать из Демонической Эссенции и Разрывателя душ вместе с Расплавленным Ядром."]
			id: "5D03084D09D2A997"
			shape: "hexagon"
			subtitle: "&7А'зар был демоном, заточённым в косу, выкованную С'келлаком, — так что это оружие пламени душ вам не союзник. Будьте осторожны: оно попытается вас предать."
			tasks: [{
				id: "43F5AAA9405EE27D"
